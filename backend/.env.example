# .env.example
# Configuración del entorno de CosmoTarot

# Base de datos local (PostgreSQL en Docker)
DATABASE_URL=postgresql://user:password@localhost:5432/cosmotarot
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=cosmotarot

# En Producción (Supabase):
# Cambiar DATABASE_URL por el string de conexión de Supabase (modo Transaction)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Google Gemini API
# GEMINI_API_KEY=tu_api_key_aqui
